/* 首页样式 */

.page-container {
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  position: relative;
  background: #f8f9fb;
}

/* ===== 顶部标题栏 ===== */
.top-title {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  padding: 0 12rpx;
}
.title-bar {
  background: #ffffff;
  padding: 16rpx 24rpx;
  padding-right: 190rpx;   /* 预留右上角胶囊按钮空间，避免被遮挡 */
  border-radius: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.10);
  margin: 10rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.title-bar-text {
  font-size: 28rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}

/* ===== 统一搜索栏 ===== */
.global-search {
  position: absolute;
  left: 0;
  right: 0;
  z-index: 990;
  padding: 0 24rpx 8rpx;
}
.gs-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}
.gs-icon { font-size: 28rpx; margin-right: 12rpx; flex-shrink: 0; }
.gs-input { flex: 1; font-size: 28rpx; height: 40rpx; }
.gs-clear { font-size: 28rpx; color: #94a3b8; padding: 0 8rpx; flex-shrink: 0; }

.title-nav {
  display: flex;
  gap: 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.title-nav-btn {
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  color: #3B82F6;
  background: #eef2ff;
}

/* ===== 底部操作栏 ===== */
.bottom-actions {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  padding: 0 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
}
.bottom-bar-inner {
  display: flex;
  gap: 16rpx;
}
.bottom-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
  position: relative;
}
.bottom-btn::after {
  border: none;
}
.bottom-btn:active {
  opacity: 0.85;
}
.bottom-btn-primary {
  background: #ffffff;
  color: #1e293b;
}
.bottom-btn-accent {
  background: #3B82F6;
  color: #ffffff;
}
.bottom-btn-plain {
  background: #ffffff;
  color: #475569;
}
.bottom-btn-plain .bottom-btn-text {
  font-size: 24rpx;
}
.bottom-btn-text {
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 地图视图 ===== */
.map-view {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}
.main-map {
  width: 100%;
  height: 100%;
}

.map-empty-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 500;
  background: #ffffff;
  padding: 40rpx 48rpx;
  border-radius: 24rpx;
  box-shadow: 0 4px 24px rgba(0,0,0,0.15);
  pointer-events: none;
  min-width: 400rpx;
}
.map-empty-hint .empty-state {
  padding: 0;
}

/* ===== 卡片列表视图 ===== */
.card-view {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #f8f9fb;
  padding: 0 16rpx 180rpx;
  padding-top: calc(44px + 120rpx);
}
.card-view-header {
  margin-bottom: 14rpx;
  padding: 0 8rpx;
}
.result-count {
  font-size: 26rpx;
  color: #64748b;
}
.count-num {
  color: #1e293b;
  font-weight: 600;
}

.card-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding-bottom: 40rpx;
}

.card {
  background: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 1px 8px rgba(0,0,0,0.08);
}
.card:active {
  box-shadow: 0 2px 12px rgba(0,0,0,0.12);
}
.card-colorbar {
  height: 10rpx;
  display: flex;
}
.bar-seg {
  height: 100%;
  flex: 1;
}
.card-body {
  padding: 24rpx 28rpx 28rpx;
}
.card-name {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.card-stars {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 12rpx;
  margin-bottom: 8rpx;
}
.star-item {
  display: inline-flex;
  align-items: center;
  gap: 2rpx;
  font-size: 18rpx;
}
.star-label {
  font-weight: 500;
  margin-right: 2rpx;
}
.star-icons {
  letter-spacing: 0;
  font-size: 16rpx;
}
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.tag-dim {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  font-weight: 500;
  color: #fff;
  line-height: 1.3;
}
.tag-cat {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
  color: #fff;
  background: #6366f1;
  line-height: 1.3;
  order: -1;
}
.card-district {
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 10rpx;
}
.card-desc {
  font-size: 24rpx;
  color: #1e293b;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* ===== 主动筛选条 ===== */
.active-bar {
  position: absolute;
  bottom: 120rpx;
  left: 24rpx;
  right: 24rpx;
  z-index: 1000;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  pointer-events: none;
}
.active-bar .filter-tag {
  pointer-events: auto;
}
.filter-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  font-weight: 500;
  box-shadow: 0 2px 12px rgba(0,0,0,0.10);
}
.filter-tag-dim {
  color: #fff;
}
.filter-tag-issue {
  background: #ffffff;
  color: #1e293b;
}
.filter-tag .remove {
  font-size: 24rpx;
  line-height: 1;
  opacity: 0.7;
  margin-left: 4rpx;
  color: inherit;
}
.filter-tag .remove:active {
  opacity: 1;
}

/* Badge */
.badge {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  background: #dc2626;
  color: #fff;
  font-size: 18rpx;
  min-width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  padding: 0 6rpx;
}

/* 空状态（卡片视图中的） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}
.empty-state .icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-state .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 12rpx;
}
.empty-state .desc {
  font-size: 26rpx;
  color: #64748b;
}

/* ===== 行为→教案 推荐 ===== */
.behavior-rec {
  padding: 16rpx 24rpx 8rpx;
}
.rec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 14rpx;
}
.rec-block {
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  border-left: 6rpx solid #f59e0b;
}
.rec-beh-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}
.rec-beh-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #b45309;
}
.rec-beh-sub {
  font-size: 22rpx;
  color: #64748b;
}
.rec-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}
.rec-clear {
  font-size: 22rpx;
  color: #94a3b8;
  padding: 4rpx 10rpx;
}
.rec-label {
  font-size: 23rpx;
  color: #92400e;
  font-weight: 500;
  margin-bottom: 10rpx;
}
.rec-guide {
  font-size: 24rpx;
  color: #92400e;
  background: #fff7ed;
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  line-height: 1.6;
  margin-bottom: 10rpx;
}
.rec-slices {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.rec-slice {
  background: #f8f9fb;
  border-radius: 10rpx;
  padding: 12rpx 14rpx;
}
.rec-slice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e293b;
  line-height: 1.4;
}
.rec-slice-meta {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}
.rec-hint {
  font-size: 20rpx;
  color: #94a3b8;
  padding: 6rpx 4rpx 10rpx;
}

/* ===== 专题分类标签 ===== */
.filter-tag-topic {
  color: #fff;
}

