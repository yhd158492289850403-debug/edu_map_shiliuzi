/* 详情页样式 */

.detail-container {
  background: #ffffff;
  min-height: 100vh;
}

.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 50vh;
  color: #999;
  font-size: 28rpx;
}

/* ===== 顶部返回栏 ===== */
.detail-top-bar {
  position: sticky;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.back-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 12rpx;
  flex-shrink: 0;
}
.back-arrow {
  font-size: 32rpx;
  color: #007AFF;
  line-height: 1;
}
.back-text {
  font-size: 26rpx;
  color: #007AFF;
  font-weight: 500;
}
.top-title-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding-right: 16rpx;
}

.detail-colorbar {
  height: 8rpx;
  display: flex;
}
.detail-colorbar .bar-seg {
  height: 100%;
  flex: 1;
}

.detail-content {
  padding: 30rpx 32rpx 40rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
  line-height: 1.3;
  color: #1a1a1a;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 30rpx;
}
.detail-tags .tag-dim {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12px;
  font-weight: 500;
  color: #fff;
}

/* 信息区块 */
.info-section {
  margin-bottom: 28rpx;
}
.section-title {
  font-size: 22rpx;
  font-weight: 600;
  color: #999;
  letter-spacing: 1rpx;
  margin-bottom: 14rpx;
}
.section-body {
  font-size: 28rpx;
  color: #1a1a1a;
  line-height: 1.8;
}

/* 信息网格 */
.info-grid {
  background: #fafafa;
  border-radius: 16px;
  padding: 20rpx 24rpx;
}
.info-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.info-row:last-child {
  border-bottom: none;
}
.info-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}
.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a1a;
}
.nav-action {
  margin-top: 16rpx;
  background: #f0f0f0;
  border-radius: 12px;
  padding: 16rpx 0;
  text-align: center;
}
.nav-action-text {
  color: #007AFF;
  font-size: 28rpx;
  font-weight: 600;
}

/* 行为问题标签 */
.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.tag-behavior {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 12px;
  font-weight: 500;
  color: #fff;
  background: #666;
}
.tag-empty {
  font-size: 24rpx;
  color: #999;
}

/* 六维素养星级 */
.star-section {
  background: #fafafa;
  border-radius: 16px;
  padding: 20rpx 24rpx;
}
.point-star-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.point-star-item {
  flex: 0 0 calc(33.33% - 12rpx);
  background: #fff;
  border-radius: 12px;
  padding: 12rpx 8rpx;
  text-align: center;
  box-shadow: 0 1px 2px rgba(0,0,0,0.04);
}
.ps-dim {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
.ps-stars {
  font-size: 26rpx;
  letter-spacing: 2rpx;
}
.ps-none {
  color: #ccc;
}

/* ===== 旅游攻略 ===== */
.slice-group {
  margin-bottom: 22rpx;
}
.slice-group-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}
.slice-group-count {
  font-size: 20rpx;
  font-weight: 500;
  color: #999;
  margin-left: 8rpx;
}
.slice-card {
  background: #fafafa;
  border-radius: 12px;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  border-left: 6rpx solid transparent;
}

.slice-card-expanded {
  border-left-color: #007AFF;
  background: #f0f8ff;
}

.slice-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}
.slice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  flex: 1;
}
.slice-star {
  font-size: 22rpx;
  flex-shrink: 0;
}
.slice-stage-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 12px;
  font-weight: 600;
  flex-shrink: 0;
}
.slice-tag-rec {
  background: #FF3B30;
  color: #fff;
}
.slice-tag-adv {
  background: #f0f0f0;
  color: #666;
}
.slice-meta {
  font-size: 22rpx;
  color: #999;
  line-height: 1.5;
}

/* 展开的攻略 */
.slice-detail {
  background: #fffdf5;
  border: 1rpx solid #fde68a;
  border-radius: 16px;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.slice-checkin-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #1a1a1a 0%, #333333 100%);
  border-radius: 12px;
  padding: 16rpx;
  text-align: center;
  color: white;
  font-size: 28rpx;
  font-weight: 600;
}

.slice-checkin-btn:active {
  opacity: 0.8;
}
.slice-detail-stars {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 14rpx;
}
.slice-detail-star {
  font-size: 22rpx;
  font-weight: 600;
}
.slice-seg {
  display: flex;
  margin-bottom: 14rpx;
}
.slice-seg-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #FF9500;
}
.slice-seg-text {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a1a;
  line-height: 1.7;
}

/* 底部标语 */
.detail-footer {
  text-align: center;
  padding: 36rpx 32rpx 28rpx;
  margin-top: 24rpx;
  background: #fafafa;
  border-radius: 16px;
  border: 1rpx solid rgba(0,0,0,0.04);
}
.footer-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}
.footer-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}
.footer-line {
  width: 80rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #1a1a1a, transparent);
  margin: 14rpx auto 0;
  border-radius: 2rpx;
}
