<!-- 附近页 -->
<view class="near-container" style="padding-top: {{statusBarHeight}}px;">

  <!-- 顶部栏 -->
  <view class="top-bar">
    <view class="btn-back" bindtap="onBack"><text>&lt; 返回</text></view>
    <text class="top-title">附近教育基地</text>
    <view class="top-right"></view>
  </view>

  <!-- 定位与半径 -->
  <view class="loc-bar">
    <view class="loc-btn {{located ? 'green' : ''}}" bindtap="onLocate">
      <text wx:if="{{locating}}">定位中…</text>
      <text wx:elif="{{located}}">📍 已定位</text>
      <text wx:else>📍 点击定位</text>
    </view>
    <view class="radius-tabs">
      <view
        class="radius-tab {{radius == r.val ? 'on' : ''}}"
        wx:for="{{radiusTabs}}"
        wx:for-item="r"
        wx:key="val"
        data-idx="{{index}}"
        bindtap="onRadius"
      >{{r.t}}</view>
    </view>
  </view>

  <!-- 维度过滤 + 搜索 -->
  <view class="filter-area">
    <scroll-view class="dim-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="dim-tabs">
        <view class="dim-tab {{!activeDim ? 'on' : ''}}" bindtap="onDimTap" data-dim="">全部</view>
        <view class="dim-tab {{item.active ? 'on' : ''}}" wx:for="{{dims}}" wx:key="key" data-dim="{{item.key}}" bindtap="onDimTap" style="{{item.active ? 'color:#fff;background:' + item.color : ''}}">{{item.label}}</view>
      </view>
    </scroll-view>
    <input class="kw-box" placeholder="搜索地点名称…" value="{{kw}}" bindinput="onKw" />
  </view>

  <!-- 结果 -->
  <scroll-view class="near-list" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="result-header" wx:if="{{located}}">共 {{total}} 个点位（≤{{radiusText}}）</view>
    <view class="result-header" wx:else>开启定位后按距离排序</view>

    <view class="near-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="onCardTap">
      <view class="near-card-main">
        <view class="near-name">{{item.n}}
          <text class="near-dist" wx:if="{{item.dist != null}}">{{item.distText}}</text>
        </view>
        <view class="near-meta">{{item.d}} · {{item.c}}<text wx:if="{{item.fee && item.fee !== '待确认'}}"> · {{item.fee}}</text></view>
        <view class="near-tags">
          <view class="near-tag" wx:for="{{item.dimTags}}" wx:key="label" style="color: {{item.color}}; border-color: {{item.color}};">{{item.label}}</view>
        </view>
      </view>
      <view class="near-nav" data-p="{{item}}" catchtap="onNav">
        <text class="nav-icon">🗺</text>
        <text class="nav-text">导航</text>
      </view>
    </view>

    <view class="empty" wx:if="{{list.length === 0}}">
      <text>没有找到附近点位，试试放大范围或调整筛选</text>
    </view>

    <view class="list-footer">操作提示：点卡片看详情，点「导航」跳到地图导航</view>
  </scroll-view>

</view>
