/* 打卡页样式 */
.checkin-container {
  min-height: 100vh;
  background: #f8f9fb;
  display: flex;
  flex-direction: column;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}
.btn-back { font-size: 26rpx; color: #3B82F6; padding: 8rpx 0; flex-shrink: 0; }
.top-title { flex: 1; text-align: center; font-size: 30rpx; font-weight: 700; color: #1e293b; }
.top-right { width: 100rpx; }

.form-scroll { flex: 1; }

.form-section {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 2rpx;
}
.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 16rpx;
}
.picker-trigger {
  padding: 20rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1e293b;
}
.placeholder { color: #94a3b8; }

/* Rating */
.rating-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}
.rating-item {
  text-align: center;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  background: #f8f9fb;
  border: 2rpx solid transparent;
}
.rating-item.active {
  background: #eef2ff;
  border-color: #3B82F6;
}
.rating-icon { font-size: 36rpx; display: block; }
.rating-text { font-size: 22rpx; color: #64748b; display: block; margin-top: 4rpx; }

/* Notes */
.notes-input {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.char-count {
  text-align: right;
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
  margin-top: 8rpx;
}

/* Photos */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.photo-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}
.photo-img {
  width: 100%;
  height: 100%;
}
.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}
.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #cbd5e1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f9fb;
}
.add-icon { font-size: 48rpx; color: #94a3b8; }
.add-text { font-size: 22rpx; color: #94a3b8; margin-top: 8rpx; }

/* Submit */
.submit-bar {
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  background: #3B82F6;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.submit-btn[disabled] {
  background: #94a3b8;
}

/* Picker */
.picker-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.3);
  z-index: 2000;
}
.picker-sheet {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 2001;
  display: flex;
  flex-direction: column;
}
.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #e2e8f0;
  font-size: 30rpx;
  font-weight: 700;
}
.picker-close { font-size: 36rpx; color: #64748b; }
.picker-list { flex: 1; max-height: 50vh; }
.picker-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}
.picker-item:active { background: #f8f9fb; }
.picker-item-name { font-size: 28rpx; color: #1e293b; display: block; }
.picker-item-meta { font-size: 22rpx; color: #94a3b8; display: block; margin-top: 4rpx; }
