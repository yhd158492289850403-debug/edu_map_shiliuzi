<!-- 个人档案页 -->
<view class="profile-container" style="padding-top: {{statusBarHeight}}px;">

  <!-- 顶部栏 -->
  <view class="top-bar">
    <view class="btn-back" bindtap="onBack"><text>&lt; 返回</text></view>
    <text class="top-title">我的探索档案</text>
    <view class="top-right"></view>
  </view>

  <!-- 用户信息 - 始终显示在最上面 -->
  <view class="user-section">
    <view class="user-avatar" bindtap="onEditProfile">
      <text wx:if="{{userInfo.avatar}}" class="avatar-img">👤</text>
      <text wx:else class="avatar-placeholder">👤</text>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickname || '微信用户'}}</text>
      <text class="user-role-tag" bindtap="onShowRolePicker">
        <text wx:if="{{isFamily}}">亲子入口</text>
        <text wx:elif="{{isGuest}}">游客入口</text>
        <text wx:elif="{{isTeam}}">团队入口</text>
        <text class="role-arrow">▼</text>
      </text>
      <text class="user-join">加入时间：{{userInfo.created_at}}</text>
    </view>
  </view>

  <!-- 入口切换弹窗 -->
  <view class="role-picker-mask" wx:if="{{showRolePicker}}" bindtap="onCloseRolePicker"></view>
  <view class="role-picker" wx:if="{{showRolePicker}}">
    <view class="role-picker-header">
      <text class="role-picker-title">切换入口</text>
      <text class="role-picker-close" bindtap="onCloseRolePicker">✕</text>
    </view>
    <view class="role-picker-body">
      <view 
        class="role-picker-item {{item.selected ? 'role-selected' : ''}}" 
        wx:for="{{roleOptions}}" 
        wx:key="key"
        data-role="{{item.key}}"
        bindtap="onRoleSelect"
      >
        <text class="role-icon">{{item.icon}}</text>
        <view class="role-info">
          <text class="role-name">{{item.label}}</text>
          <text class="role-desc">{{item.description}}</text>
        </view>
        <text class="role-check" wx:if="{{item.selected}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 观察期提示 - 仅亲子和游客显示 -->
  <observation-period wx:if="{{!isTeam}}" bind:ready="onAssessmentReady" />

  <!-- 已评估后显示报告入口 - 仅亲子和游客显示 -->
  <view class="report-entry" wx:if="{{!isObserving && !isTeam}}">
    <button bindtap="goToReport">查看探索报告</button>
  </view>

  <!-- 游客专属提示 -->
  <view class="guest-tip" wx:if="{{isGuest}}">
    <view class="tip-card">
      <text class="tip-icon">🌍</text>
      <text class="tip-title">我的探索档案</text>
      <text class="tip-desc">记录你的探索足迹，解锁更多成就徽章！</text>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-num">{{stats.totalCheckins}}</text>
      <text class="stat-label">{{isGuest ? '完成打卡' : '打卡次数'}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.totalPoints}}</text>
      <text class="stat-label">{{isGuest ? '探索点位' : '访问点位'}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.totalBehaviors}}</text>
      <text class="stat-label">{{isGuest ? '探索行为' : '探索行为'}}</text>
    </view>
    <view class="stat-card">
      <text class="stat-num">{{stats.streak}}</text>
      <text class="stat-label">连续打卡</text>
    </view>
  </view>

  <!-- 团队数据 -->
  <view class="team-section" wx:if="{{isTeam}}">
    <view class="team-title">团队数据</view>
    
    <view class="class-stats">
      <view class="class-stat-item">
        <text class="class-stat-value">{{classData.totalStudents}}</text>
        <text class="class-stat-label">成员总数</text>
      </view>
      <view class="class-stat-item">
        <text class="class-stat-value">{{classData.activeStudents}}</text>
        <text class="class-stat-label">活跃成员</text>
      </view>
      <view class="class-stat-item">
        <text class="class-stat-value">{{classData.averageCheckins}}</text>
        <text class="class-stat-label">平均打卡</text>
      </view>
    </view>
    
    <view class="student-list">
      <view 
        class="student-item" 
        wx:for="{{students}}" 
        wx:key="_openid"
        data-openid="{{item._openid}}"
        bindtap="onViewStudent"
      >
        <text class="student-name">{{item.nickname}}</text>
        <text class="student-checkins">打卡{{item.behaviors.length}}次</text>
      </view>
    </view>
    
    <button class="export-class-btn" bindtap="onExportClassReport">
      导出团队汇总表
    </button>
  </view>

  <!-- 内容偏好 - 仅亲子显示 -->
  <view class="stage-section" wx:if="{{isFamily}}">
    <text class="section-title">🎯 内容偏好</text>
    <text class="stage-hint">选择内容难度，推荐更适合的出行攻略</text>
    <view class="stage-chips">
      <view class="stage-chip {{stage === '全部' ? 'stage-active' : ''}}" data-stage="全部" bindtap="onStageChange">全部</view>
      <view class="stage-chip {{stage === '基础' ? 'stage-active' : ''}}" data-stage="基础" bindtap="onStageChange">基础</view>
      <view class="stage-chip {{stage === '进阶' ? 'stage-active' : ''}}" data-stage="进阶" bindtap="onStageChange">进阶</view>
      <view class="stage-chip {{stage === '高级' ? 'stage-active' : ''}}" data-stage="高级" bindtap="onStageChange">高级</view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-btn primary" bindtap="onCheckin">
      <text class="action-icon">📝</text>
      <text class="action-text">立即打卡</text>
    </view>
    <view class="action-btn secondary" bindtap="onReplayGuide">
      <text class="action-icon">🎯</text>
      <text class="action-text">新手引导</text>
    </view>
  </view>

  <!-- 打卡历史 -->
  <view class="history-section">
    <text class="section-title">📅 打卡历史</text>

    <view wx:if="{{loading}}" class="loading">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{checkins.length === 0}}" class="empty-state">
      <text class="empty-icon">📸</text>
      <text class="empty-text">{{isGuest ? '还没有探索记录' : '还没有打卡记录'}}</text>
      <text class="empty-hint">{{isGuest ? '快去探索景点吧！' : '点击"立即打卡"记录你的探索足迹'}}</text>
    </view>

    <view wx:else class="checkin-list">
      <view class="checkin-item" wx:for="{{checkins}}" wx:key="_id" data-id="{{item._id}}" bindtap="onCheckinDetail">
        <view class="checkin-header">
          <text class="checkin-point">{{item.point_name}}</text>
          <text class="checkin-date">{{item.date}}</text>
        </view>
        <view class="checkin-behavior" wx:if="{{item.behavior}}">
          <text>行为：</text>
          <text class="behavior-tag">{{item.behavior}}</text>
        </view>
        <view class="checkin-rating" wx:if="{{item.rating}}">
          <text>评价：</text>
          <text wx:if="{{item.rating === 'great'}}">🌟 很棒</text>
          <text wx:elif="{{item.rating === 'good'}}">👍 不错</text>
          <text wx:elif="{{item.rating === 'ok'}}">👍 还行</text>
          <text wx:else>🤔 待改进</text>
        </view>
        <view class="checkin-notes" wx:if="{{item.notes}}">
          <text>{{item.notes}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
