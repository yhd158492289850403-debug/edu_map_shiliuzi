/* 个人档案页样式 */
.profile-container {
  min-height: 100vh;
  background: #f8f9fb;
  display: flex;
  flex-direction: column;
}

/* 顶部栏 */
.top-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}
.btn-back { font-size: 26rpx; color: #3B82F6; padding: 8rpx 0; flex-shrink: 0; }
.top-title { flex: 1; text-align: center; font-size: 30rpx; font-weight: 700; color: #1e293b; }
.top-right { width: 100rpx; }

/* 用户信息 */
.user-section {
  display: flex;
  align-items: center;
  padding: 30rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.avatar-img, .avatar-placeholder { font-size: 60rpx; }
.user-info { flex: 1; }
.user-name { font-size: 36rpx; font-weight: 700; display: block; }
.user-join { font-size: 24rpx; opacity: 0.8; display: block; margin-top: 8rpx; }

/* 统计卡片 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  padding: 24rpx;
  background: #fff;
  margin: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.stat-card {
  text-align: center;
  padding: 16rpx 8rpx;
}
.stat-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #3B82F6;
  display: block;
}
.stat-label {
  font-size: 22rpx;
  color: #64748b;
  display: block;
  margin-top: 8rpx;
}

/* 学段设置 */
.stage-section {
  padding: 24rpx;
  margin: 0 24rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.stage-hint {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
  margin-bottom: 16rpx;
}
.stage-chips {
  display: flex;
  gap: 16rpx;
}
.stage-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 24rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #64748b;
  background: #f1f5f9;
  transition: all 0.2s;
}
.stage-chip.stage-active {
  background: #3B82F6;
  color: #ffffff;
  font-weight: 600;
}

/* 快捷操作 */
.quick-actions {
  padding: 0 24rpx 24rpx;
}
.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.action-btn.primary {
  background: #3B82F6;
  color: #fff;
}
.action-icon { font-size: 32rpx; }

/* 历史记录 */
.history-section {
  flex: 1;
  padding: 0 24rpx 40rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 24rpx;
}

.loading { text-align: center; padding: 60rpx 0; color: #94a3b8; font-size: 26rpx; }

.empty-state {
  text-align: center;
  padding: 60rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.empty-text { font-size: 28rpx; font-weight: 600; color: #1e293b; display: block; }
.empty-hint { font-size: 24rpx; color: #94a3b8; display: block; margin-top: 12rpx; }

.checkin-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.checkin-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 6rpx solid #3B82F6;
}
.checkin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.checkin-point {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}
.checkin-date {
  font-size: 22rpx;
  color: #94a3b8;
}
.checkin-behavior {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}
.behavior-tag {
  display: inline-block;
  background: #eef2ff;
  color: #3B82F6;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}
.checkin-rating {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}
.checkin-notes {
  font-size: 24rpx;
  color: #1e293b;
  background: #f8f9fb;
  padding: 12rpx;
  border-radius: 8rpx;
  line-height: 1.5;
}

/* 教师班级数据 */
.teacher-section {
  margin: 24rpx;
  padding: 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.teacher-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 30rpx;
}

.class-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.class-stat-item {
  text-align: center;
}

.class-stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #4ECDC4;
  display: block;
}

.class-stat-label {
  font-size: 24rpx;
  color: #64748b;
}

.student-list {
  margin-bottom: 30rpx;
}

.student-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 10rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}

.student-name {
  font-size: 28rpx;
  color: #1e293b;
}

.student-checkins {
  font-size: 24rpx;
  color: #64748b;
}

.export-class-btn {
  background: #667eea;
  color: white;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: bold;
  border: none;
}

.export-class-btn::after {
  border: none;
}

/* 用户角色标签 */
.user-role {
  display: inline-block;
  font-size: 20rpx;
  background: rgba(255,255,255,0.3);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-top: 8rpx;
}

/* 学生专属提示 */
.student-tip {
  padding: 24rpx;
}

.tip-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 30rpx;
  color: white;
  text-align: center;
}

.tip-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 16rpx;
}

.tip-title {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.tip-desc {
  font-size: 24rpx;
  opacity: 0.9;
  display: block;
}
