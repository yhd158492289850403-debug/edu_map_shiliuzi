/* 筛选面板组件 v3 · 层级折叠 + 多选行为 */

.sheet-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(0,0,0,0.3); z-index: 2000; }
.filter-sheet {
  position: fixed; bottom: 0; left: 0; right: 0;
  max-height: 80vh; background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4px 24px rgba(0,0,0,0.15);
  z-index: 2001; display: flex; flex-direction: column;
  animation: slideUp 0.3s ease;
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.sheet-handle { width: 80rpx; height: 8rpx; background: #cbd5e1; border-radius: 4rpx; margin: 16rpx auto 0; }
.sheet-header { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 32rpx 12rpx; border-bottom: 1rpx solid #e2e8f0; }
.sheet-title { font-size: 28rpx; font-weight: 700; }
.sheet-close { font-size: 36rpx; background: none; border: none; color: #64748b; padding: 0 8rpx; }
.sheet-body { flex: 1; overflow-y: auto; padding: 16rpx 32rpx; }
.sheet-actions { display: flex; gap: 16rpx; padding: 16rpx 32rpx; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e2e8f0; }
.sheet-actions .sheet-btn { flex: 1; height: 76rpx; border-radius: 38rpx; font-size: 26rpx; font-weight: 600; }
.btn-reset { background: #f1f5f9; color: #64748b; }
.btn-apply { background: #3B82F6; color: #fff; }
.btn-apply:disabled { background: #94a3b8; }

/* filter section */
.filter-section { margin-bottom: 20rpx; }
.filter-section-title { font-size: 22rpx; font-weight: 600; color: #64748b; margin-bottom: 10rpx; display: block; }
.search-box { width: 100%; padding: 18rpx 20rpx; border: 1.5px solid #e2e8f0; border-radius: 12rpx; font-size: 26rpx; background: #f8f9fb; height: 68rpx; }

/* ===== 层级折叠 ===== */
.fold-header { display: flex; align-items: center; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx dashed #e2e8f0; }
.fold-title { font-size: 26rpx; font-weight: 600; }
.fold-arrow { font-size: 20rpx; color: #94a3b8; }
.fold-body { padding: 10rpx 0 4rpx; }

/* Level 2: dim chips */
.dim-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.dim-chip { padding: 10rpx 20rpx; border-radius: 32rpx; font-size: 24rpx; font-weight: 500; border: 2rpx solid transparent; }
.dim-chip.active { color: #fff !important; border-color: transparent; }

/* Level 3: sub-literacy list */
.sub-list { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 4rpx; }
.sub-item { display: flex; align-items: center; justify-content: space-between; background: #f8f9fb; border: 1rpx solid #e2e8f0; border-radius: 14rpx; padding: 14rpx 18rpx; }
.sub-item:active { background: #eef2ff; }
.sub-item.sub-active { border-color: #3B82F6; background: #eef2ff; }
.sub-name { font-size: 25rpx; font-weight: 600; }
.sub-beh-count { font-size: 21rpx; color: #94a3b8; }
.sub-empty { font-size: 22rpx; color: #94a3b8; padding: 10rpx 0; }

/* Level 4: action list (多选) */
.action-list { margin-top: 12rpx; display: flex; flex-direction: column; gap: 10rpx; }
.action-hint { font-size: 20rpx; color: #3B82F6; margin-bottom: 4rpx; font-weight: 500; }
.action-item {
  display: flex; align-items: center; gap: 10rpx;
  padding: 14rpx 16rpx; border-radius: 10rpx;
  background: #fff; border: 1rpx solid #e2e8f0;
}
.action-item:active { background: #eef2ff; }
.action-item.action-checked { border-color: #3B82F6; background: #eef2ff; }
.action-check { font-size: 28rpx; color: #3B82F6; flex-shrink: 0; width: 36rpx; text-align: center; }
.action-name { font-size: 24rpx; font-weight: 600; flex: 1; }
.action-count { font-size: 21rpx; color: #94a3b8; flex-shrink: 0; }

/* 已选行为标签栏 */
.selected-bar { margin-top: 16rpx; padding: 12rpx 16rpx; background: #f0f9ff; border-radius: 12rpx; border: 1rpx solid #bae6fd; }
.selected-label { font-size: 22rpx; font-weight: 600; color: #0369a1; display: block; margin-bottom: 10rpx; }
.selected-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.selected-tag {
  display: inline-flex; align-items: center; gap: 6rpx;
  padding: 6rpx 14rpx; border-radius: 20rpx;
  background: #3B82F6; color: #fff;
  font-size: 22rpx; font-weight: 500;
}
.tag-x { font-size: 20rpx; opacity: 0.8; padding-left: 4rpx; }
