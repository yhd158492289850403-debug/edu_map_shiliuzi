.report-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.header-left {
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #999;
}

.header-right {
  display: flex;
  align-items: baseline;
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
}

.score-label {
  font-size: 24rpx;
  color: #999;
  margin-left: 4rpx;
}

.level-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #fff;
  margin-bottom: 20rpx;
}

.dimensions {
  margin-bottom: 20rpx;
}

.dim-item {
  margin-bottom: 20rpx;
}

.dim-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.dim-label {
  font-size: 26rpx;
  color: #333;
}

.dim-score {
  font-size: 26rpx;
  font-weight: bold;
}

.dim-bar {
  height: 14rpx;
  background: #f0f0f0;
  border-radius: 7rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.dim-fill {
  height: 100%;
  border-radius: 7rpx;
  transition: width 0.3s ease;
}

.dim-desc {
  font-size: 22rpx;
  color: #666;
  line-height: 1.5;
}

.section-label {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.highlights,
.suggestions {
  margin-bottom: 20rpx;
}

.list-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10rpx;
}

.item-dot {
  color: #4ECDC4;
  margin-right: 10rpx;
  font-size: 24rpx;
}

.item-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

.encouragement {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 15rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.encouragement text {
  font-size: 24rpx;
  color: #fff;
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  border-radius: 50rpx;
  padding: 16rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
}

.export-btn {
  background: #4ECDC4;
  color: #fff;
}

.export-btn::after {
  border: none;
}

.share-btn {
  background: #667eea;
  color: #fff;
}

.share-btn::after {
  border: none;
}
