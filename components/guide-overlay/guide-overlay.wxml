<view class="guide-overlay" wx:if="{{show}}">
  <!-- 遮罩层（禁止点击穿透） -->
  <view class="guide-mask" catchtap="onMaskTap"></view>
  
  <!-- 高亮区域 -->
  <view 
    class="guide-highlight" 
    wx:if="{{highlightRect}}"
    style="left:{{highlightRect.left}}px;top:{{highlightRect.top}}px;width:{{highlightRect.width}}px;height:{{highlightRect.height}}px;"
  ></view>
  
  <!-- 手指动画 -->
  <view 
    class="guide-finger {{fingerClass}}" 
    wx:if="{{highlightRect && isReady}}"
    style="{{fingerStyle}}"
  >
    <view class="finger-hand">👆</view>
  </view>
  
  <!-- 气泡说明 -->
  <view 
    class="guide-bubble" 
    wx:if="{{currentStep && isReady}}"
    style="{{bubbleStyle}}"
  >
    <!-- 进度条 -->
    <view class="bubble-progress">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{globalStep / globalTotal * 100}}%"></view>
      </view>
      <text class="progress-text">{{globalStep}}/{{globalTotal}}</text>
    </view>
    
    <!-- 站点信息 -->
    <view class="bubble-station">
      <text class="station-label">{{stationName}}</text>
      <text class="station-count">({{stepInStation}}/{{stepTotal}})</text>
    </view>
    
    <!-- 标题 -->
    <view class="bubble-title">{{currentStep.title}}</view>
    
    <!-- 描述 -->
    <view class="bubble-desc">{{currentStep.desc}}</view>
    
    <!-- 演示提示 -->
    <view class="bubble-demo" wx:if="{{currentStep.demo}}">
      <text class="demo-icon">💡</text>
      <text class="demo-text">{{currentStep.demo}}</text>
    </view>
    
    <!-- 操作按钮 -->
    <view class="bubble-footer">
      <view class="bubble-skip" bindtap="onSkip">跳过引导</view>
      <view class="bubble-next" bindtap="onNext">
        <text>{{globalStep === globalTotal ? '完成' : '下一步'}}</text>
        <text class="next-arrow" wx:if="{{globalStep < globalTotal}}"> →</text>
      </view>
    </view>
  </view>
</view>
