/* 新手引导组件样式 */

.guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

/* 遮罩层 */
.guide-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  animation: fadeIn 0.3s ease;
}

/* 高亮区域 */
.guide-highlight {
  position: absolute;
  border-radius: 12px;
  background: transparent;
  box-shadow: 0 0 0 4000px rgba(0, 0, 0, 0.7);
  animation: highlightPulse 1.5s ease-in-out infinite;
  z-index: 10000;
}

@keyframes highlightPulse {
  0%, 100% { box-shadow: 0 0 0 4000px rgba(0, 0, 0, 0.7); }
  50% { box-shadow: 0 0 0 4000px rgba(0, 0, 0, 0.6); }
}

/* 手指动画 */
.guide-finger {
  position: absolute;
  z-index: 10001;
  animation: fingerAppear 0.3s ease;
}

.finger-hand {
  font-size: 48rpx;
  transform: rotate(-30deg);
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3));
}

/* 手指指向动画 */
.guide-finger.finger-point .finger-hand {
  animation: fingerPoint 1s ease-in-out infinite;
}

/* 手指点击动画 */
.guide-finger.finger-tap .finger-hand {
  animation: fingerTap 1s ease-in-out infinite;
}

/* 手指滑动动画 */
.guide-finger.finger-swipe .finger-hand {
  animation: fingerSwipe 1.5s ease-in-out infinite;
}

@keyframes fingerAppear {
  from { 
    opacity: 0; 
    transform: translateY(20px); 
  }
  to { 
    opacity: 1; 
    transform: translateY(0); 
  }
}

@keyframes fingerPoint {
  0%, 100% { transform: translateY(0) rotate(-30deg); }
  50% { transform: translateY(-10px) rotate(-30deg); }
}

@keyframes fingerTap {
  0%, 100% { transform: scale(1) rotate(-30deg); }
  50% { transform: scale(0.85) rotate(-30deg); }
}

@keyframes fingerSwipe {
  0% { transform: translateX(0) rotate(-30deg); }
  50% { transform: translateX(30px) rotate(-30deg); }
  100% { transform: translateX(0) rotate(-30deg); }
}

/* 气泡说明 */
.guide-bubble {
  position: absolute;
  width: 480rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  color: white;
  z-index: 10001;
  animation: bubbleAppear 0.4s ease;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

@keyframes bubbleAppear {
  from { 
    opacity: 0; 
    transform: scale(0.8) translateY(10px); 
  }
  to { 
    opacity: 1; 
    transform: scale(1) translateY(0); 
  }
}

.bubble-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.bubble-desc {
  font-size: 26rpx;
  line-height: 1.6;
  opacity: 0.9;
  margin-bottom: 24rpx;
}

.bubble-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bubble-skip {
  font-size: 24rpx;
  opacity: 0.7;
  padding: 8rpx 16rpx;
}

.bubble-step {
  font-size: 22rpx;
  opacity: 0.6;
}

.bubble-next {
  font-size: 28rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.2);
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
}

.bubble-next:active {
  background: rgba(255, 255, 255, 0.3);
}

/* 淡入动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
