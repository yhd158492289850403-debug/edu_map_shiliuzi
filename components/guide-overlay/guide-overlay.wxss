/* 全项目新手引导组件样式 */

.guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

/* 遮罩层（禁止点击穿透） */
.guide-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  animation: fadeIn 0.3s ease;
}

/* 高亮区域 */
.guide-highlight {
  position: absolute;
  border-radius: 12px;
  background: transparent;
  box-shadow: 0 0 0 4000px rgba(0, 0, 0, 0.75);
  animation: highlightPulse 1.5s ease-in-out infinite;
  z-index: 10000;
}

@keyframes highlightPulse {
  0%, 100% { box-shadow: 0 0 0 4000px rgba(0, 0, 0, 0.75); }
  50% { box-shadow: 0 0 0 4000px rgba(0, 0, 0, 0.65); }
}

/* 手指动画 */
.guide-finger {
  position: absolute;
  z-index: 10001;
  animation: fingerAppear 0.3s ease;
}

.finger-hand {
  font-size: 56rpx;
  transform: rotate(-30deg);
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.4));
}

.guide-finger.finger-point .finger-hand {
  animation: fingerPoint 1s ease-in-out infinite;
}

.guide-finger.finger-tap .finger-hand {
  animation: fingerTap 1s ease-in-out infinite;
}

.guide-finger.finger-swipe .finger-hand {
  animation: fingerSwipe 1.5s ease-in-out infinite;
}

@keyframes fingerAppear {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes fingerPoint {
  0%, 100% { transform: translateY(0) rotate(-30deg); }
  50% { transform: translateY(-12px) rotate(-30deg); }
}

@keyframes fingerTap {
  0%, 100% { transform: scale(1) rotate(-30deg); }
  50% { transform: scale(0.85) rotate(-30deg); }
}

@keyframes fingerSwipe {
  0% { transform: translateX(0) rotate(-30deg); }
  50% { transform: translateX(30px) rotate(-30deg); }
  100% { transform: translateX(0) rotate(-30deg); }
}

/* 气泡说明 */
.guide-bubble {
  position: absolute;
  width: 560rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 28rpx;
  padding: 36rpx;
  color: white;
  z-index: 10001;
  animation: bubbleAppear 0.4s ease;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.4);
}

@keyframes bubbleAppear {
  from { opacity: 0; transform: scale(0.85) translateY(10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

/* 进度条 */
.bubble-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.progress-bar {
  flex: 1;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: white;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  opacity: 0.8;
  white-space: nowrap;
}

/* 站点信息 */
.bubble-station {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.station-label {
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.station-count {
  font-size: 22rpx;
  opacity: 0.7;
}

/* 标题 */
.bubble-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  line-height: 1.3;
}

/* 描述 */
.bubble-desc {
  font-size: 28rpx;
  line-height: 1.6;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

/* 演示提示 */
.bubble-demo {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.15);
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.demo-icon {
  font-size: 28rpx;
}

.demo-text {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 操作按钮 */
.bubble-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bubble-skip {
  font-size: 26rpx;
  opacity: 0.6;
  padding: 12rpx 20rpx;
}

.bubble-skip:active {
  opacity: 0.8;
}

.bubble-next {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.bubble-next:active {
  background: rgba(255, 255, 255, 0.35);
}

.next-arrow {
  margin-left: 8rpx;
}

/* 淡入动画 */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
